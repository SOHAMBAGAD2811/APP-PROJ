# AiRA Backend Environment Configuration
PORT=8000

# ── AiRA Neural Engine (Google Gemini API Key for Serverless Deployment) ───────
# Get your API key at: https://aistudio.google.com/
# On Vercel, add this under Project Settings -> Environment Variables
GEMINI_API_KEY=

# ── Supabase Cloud Database (PostgreSQL) ───────────────────────────────────────
# Create a free project at https://supabase.com/
# Copy the Project URL and anon public / service_role key from Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
# Optional: Service Role Key (bypasses RLS for administrative background sync)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Optional: Direct PostgreSQL URI (from Supabase Database -> Connection pooling)
# DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
