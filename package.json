{
  "name": "aira-prototype",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"API,WEB\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build && npm run build:api",
    "build:client": "vite build",
    "build:api": "node scripts/build_api.js",
    "start": "tsx server/index.ts",
    "preview": "vite preview",
    "db:seed": "tsx scripts/seed_supabase.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.7",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.45.0",
    "pg": "^8.23.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "recharts": "^2.10.3"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.11",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@vercel/node": "^3.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "esbuild": "^0.20.2",
    "tsx": "^4.19.0",
    "typescript": "^5.4.5",
    "vite": "^5.0.0"
  }
}
